{
  "name": "first",
  "version": "0.0.1",
  "description": "",
  "author": {
    "name": "Ivan Omonte Carreño",
    "email": "ivanalex.oc@gmail.com",
    "linkedIn": "https://www.linkedin.com/in/ivan-omonte-carreno/"
  },
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check --end-of-line auto \"package.json\" \".github/workflows/main.yaml\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "lint:check": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "ci:backend:metrics": "node tools/ci/backend-metrics.mjs",
    "test": "jest -c ./jest.config.ts",
    "test:unit": "jest -c ./jest.config.ts --runInBand --testPathPattern=test/unit/",
    "test:acceptance": "jest -c ./jest.config.ts --runInBand --testPathPattern=test/acceptance/",
    "test:integration": "jest -c ./jest.config.ts --runInBand --testPathPattern=test/integration/",
    "test:watch": "jest -c ./jest.config.ts --watch",
    "test:cov": "jest -c ./jest.config.ts --coverage",
    "test:cov:unit": "node --max-old-space-size=4096 ./node_modules/jest/bin/jest.js -c ./jest.config.ts --runInBand --coverage --testPathPattern=test/unit/ --coverageDirectory=coverage/unit --watch=false",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand -c ./jest.config.ts",
    "test:e2e": "jest -c ./jest.config.ts --runInBand --testPathPattern=test/end-to-end/",
    "test:e2e:institutional": "jest -c ./jest.config.ts --runInBand --runTestsByPath test/end-to-end/institutional-voting.e2e.spec.ts",
    "test:module:auth-admin": "node tools/run-module-tests.mjs matrix_03",
    "test:matrix:03": "node tools/run-module-tests.mjs matrix_03",
    "test:matrix:04": "node tools/run-module-tests.mjs matrix_04",
    "test:matrix:05": "node tools/run-module-tests.mjs matrix_05",
    "test:matrix:06": "node tools/run-module-tests.mjs matrix_06",
    "test:matrix:07": "node tools/run-module-tests.mjs matrix_07",
    "test:matrix:08": "node tools/run-module-tests.mjs matrix_08",
    "test:matrix:02": "node tools/run-module-tests.mjs institutional-access",
    "test:module:institutional-access": "node tools/run-module-tests.mjs institutional-access",
    "test:module:users-zk": "node tools/run-module-tests.mjs users-zk",
    "test:module:results": "node tools/run-module-tests.mjs results",
    "test:module:ballots-worksheets": "node tools/run-module-tests.mjs ballots-worksheets",
    "test:module:attestation": "node tools/run-module-tests.mjs attestation",
    "test:module:geography": "node tools/run-module-tests.mjs geography",
    "test:module:institutional-voting": "node tools/run-module-tests.mjs institutional-voting_remaining",
    "test:module:notifications-mail": "node tools/run-module-tests.mjs notifications-mail",
    "test:module:contracts-reports": "node tools/run-module-tests.mjs contracts-reports",
    "test:module:health-core-database": "node tools/run-module-tests.mjs health-core-database",
    "test:module:payments": "node tools/run-module-tests.mjs payments_remaining",
    "test:module:tvd": "node tools/run-module-tests.mjs tvd_remaining",
    "test:module:history": "node tools/run-module-tests.mjs history",
    "test:modules": "node tools/run-module-tests.mjs all",
    "test:modules:check": "node tools/run-module-tests.mjs check",
    "import:electoral": "ts-node -r tsconfig-paths/register src/scripts/import-prov-dept.ts --file ./final_data_replaced.json",
    "seed:big": "node scripts/seed-big-mock.js",
    "seed:attests": "node scripts/seed-attests.js",
    "seed:live-scale": "node scripts/load-live-scale.js",
    "resolve:now": "ts-node -r tsconfig-paths/register scripts/resolve-now.ts"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.1047.0",
    "@google/genai": "^1.52.0",
    "@iden3/js-iden3-auth": "^1.14.0",
    "@nestjs/axios": "^4.0.1",
    "@nestjs/cache-manager": "^3.1.2",
    "@nestjs/common": "^11.1.21",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.21",
    "@nestjs/jwt": "^11.0.2",
    "@nestjs/mapped-types": "*",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.1.21",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/serve-static": "^5.0.5",
    "@nestjs/swagger": "^11.4.3",
    "axios": "1.11.0",
    "bcrypt": "^6.0.0",
    "cache-manager": "^7.2.8",
    "cache-manager-redis-store": "^3.0.1",
    "circomlibjs": "^0.1.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "ejs": "^3.1.10",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "firebase-admin": "^13.10.0",
    "keyv": "^5.6.0",
    "mongodb": "^7.2.0",
    "mongoose": "^9.6.2",
    "multer": "^2.1.1",
    "ox": "0.8.9",
    "papaparse": "^5.5.3",
    "permissionless": "^0.3.5",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "viem": "^2.49.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@nestjs/cli": "^11.0.21",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.21",
    "@swc/cli": "^0.6.0",
    "@swc/core": "^1.15.33",
    "@types/circomlibjs": "^0.1.6",
    "@types/ejs": "^3.1.5",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.19.19",
    "@types/papaparse": "^5.5.2",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.4.2",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "globals": "^16.5.0",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^11.1.0",
    "prettier": "^3.8.3",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.59.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
