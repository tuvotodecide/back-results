# Runtime base
PORT=3000
NODE_ENV=development

# Mantener estos defaults solo si coinciden con el comportamiento actual
# esperado por frontend, CI y despliegues.

# Auth
JWT_SECRET=change-me
JWT_EXPIRATION_TIME=24h

# API key (alternative auth for select endpoints, e.g. History module)
API_KEY_HEADER=x-api-key
API_KEYS=

# Database
MONGODB_URI=mongodb://localhost:27017/electoral_db
MONGODB_USERNAME=
MONGODB_PASSWORD=

# Cache / Redis
# Obligatorio en despliegues multiinstancia para sesiones ZK y continuaciones D3 compartidas.
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL=300
CACHE_MAX=100

# HTTP / frontend integration
CORS_ORIGINS=http://localhost:5173
PUBLIC_RESULTS_WEB_BASE_URL=

# Non-production seed/testing endpoints
# Enable only in local/test environments that explicitly need /testing routes.
ENABLE_MOCKS=false

# Firebase Admin
FB_PROJECT_ID=
FB_CLIENT_EMAIL=
FB_PRIVATE_KEY=

# Mail / SES
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
SES_REGION=us-east-1
SES_FROM_MAIL=noreply@example.com
EMAIL_LOGO_URL=
EMAIL_VERIFICATION_BASE_URL=
EMAIL_VERIFICATION_TOKEN_TTL_HOURS=24
PASSWORD_RESET_BASE_URL=
PASSWORD_RESET_TOKEN_TTL_HOURS=2

# Backend error alert emails
ERROR_ALERT_EMAIL_TO=

# ZK Auth
ZK_AUTH_API_KEY_TTL=86400
ZK_AUTH_CALLBACK_URL=
VOTE_CALLBACK_URL
REWARD_CALLBACK_URL=<REWARD_CALLBACK_URL>

# Institutional mobile ZK authorization
# Full public URL ending in /api/v1/mobile/institutional-authorizations/auth/callback.
INSTITUTIONAL_MOBILE_AUTH_CALLBACK_URL=
INSTITUTIONAL_MOBILE_AUTH_TTL_MS=600000
INSTITUTIONAL_MOBILE_AUTH_PENDING_TTL_MS=180000
INSTITUTIONAL_MOBILE_AUTH_REGISTRATION_CONTINUATION_TTL_MS=300000

VERIFIER_DID=
ZK_AUTH_RPC_URL=
ZK_AUTH_NETWORK=
ZK_AUTH_STATE_CONTRACT=
IPFS_GATEWAY_URL=https://ipfs.io

# On-chain / account abstraction
CHAIN=base-sepolia
CHAINA=base-sepolia
NFT_PARTICIPATION_PRIVATE_KEY=
FACTORY=
SPONSORSHIP_POLICY=
BUNDLER=
BUNDLER_MAIN=
BUNDLER_ARBITRUM=
BUNDLER_MAIN_ARBITRUM=

# On-chain contract addresses / deployment tx hashes
TVD_TOKEN_ADDRESS=0xeA5f754B3F731D048388b688eC7910Eb3b797606
TVD_TOKEN_TX_HASH=
CORE_VESTING_ADDRESS=0x314b301d9818E082c9536d02FDA1be68f2969E0E
CORE_VESTING_TX_HASH=
INSTITUTIONAL_VESTING_ADDRESS=0xc14f10Afe32fae43D152Cc6Ab758C2b453a35b16
INSTITUTIONAL_VESTING_TX_HASH=
INCENTIVE_CAMPAIGNS_ADDRESS=0x78D7215D20EB2e2DD1F80400E3A9228B0E7166d5
INCENTIVE_CAMPAIGNS_TX_HASH=
TVD_ELECTORAL_CREDITS_ADDRESS=0xA1e9cf68769Bd676e536c45c5B0E5215216e511f
TVD_ELECTORAL_CREDITS_TX_HASH=
VOTE_MANAGER_PROXY_ADDRESS=0x36D4b585d0A05D12B7fa3A4cAD7f7C28e920C523
TVD_VOTE_MANAGER_ADDRESS=0x36D4b585d0A05D12B7fa3A4cAD7f7C28e920C523
TVD_VOTE_MANAGER_TX_HASH=
TVD_VOTE_MANAGER_IMPLEMENTATION_ADDRESS=0x24638b4A7fcbF4fC1B971F17Fcd2bae77777D3eF
TVD_MULTISIG_WALLET_ADDRESS=0x5D1E6D936a28041bE5fEE3983289c4Bbef8360e4
TVD_MULTISIG_WALLET_TX_HASH=
OFFICIAL_PUBLICATION_ARTIFACT_ENCRYPTION_KEY=
OFFICIAL_PUBLICATION_ENTRY_POINT_ADDRESS=
OFFICIAL_PUBLICATION_ENTRY_POINT_VERSION=0.6
OFFICIAL_PUBLICATION_REQUIRED_CONFIRMATIONS=1
OFFICIAL_PUBLICATION_RECONCILIATION_ENABLED=false
OFFICIAL_PUBLICATION_RECONCILIATION_INTERVAL_MS=10000
OFFICIAL_PUBLICATION_RECONCILIATION_BATCH_SIZE=10
OFFICIAL_PUBLICATION_RECONCILIATION_LOCK_MS=60000
OFFICIAL_PUBLICATION_MAX_RETRIES=5

# Internal operations
INTERNAL_PUSH_SECRET=
RUN_BACKFILL_GEO=0
TSE_MESA_ENDPOINT=

# Red Enlace QR
RED_ENLACE_MODE=mock
RED_ENLACE_BASE_URL=
# RED_ENLACE_API_KEY: backend hacia Red Enlace.
RED_ENLACE_API_KEY=
RED_ENLACE_HTTP_TIMEOUT_MS=5000
RED_ENLACE_QR_TTL=00:30:00
RED_ENLACE_WEBHOOK_AUTH_MODE=api-key
# RED_ENLACE_CALLBACK_TOKEN: Red Enlace hacia nuestro callback.
RED_ENLACE_CALLBACK_TOKEN=
RED_ENLACE_MOCK_VERIFY_STATUS=
RED_ENLACE_MIN_AMOUNT_MINOR=1
RED_ENLACE_MAX_AMOUNT_MINOR=100000000
RED_ENLACE_REGENERATION_QUOTE_TTL_MS=900000
RED_ENLACE_REGENERATION_LOCK_DURATION_MS=60000
RED_ENLACE_BRANCH_CODE=461362
RED_ENLACE_BRANCH_NAME=BLOCKCHAIN API QR
RED_ENLACE_BUSINESS_CATEGORY=7372
RED_ENLACE_GLOSA_PREFIX=PAGO
# Proteccion interna; dejar vacio para usar el limite seguro por defecto.
RED_ENLACE_MAX_QR_IMAGE_BYTES=

# TVD accounting and isolated blockchain integration
TVD_RPC_URL=<BASE_SEPOLIA_RPC_URL>
TVD_CHAIN_ID=84532
TVD_TOKEN_CONTRACT_ADDRESS=0xeA5f754B3F731D048388b688eC7910Eb3b797606
TVD_ASSIGNMENT_CONTRACT_ADDRESS=0xc14f10Afe32fae43D152Cc6Ab758C2b453a35b16
TVD_OPERATOR_PRIVATE_KEY=<OPERATOR_PRIVATE_KEY>
TVD_CONFIRMATIONS_REQUIRED=1
# Provisional: validar este valor contra token.decimals() on-chain antes de asignar.
TVD_DECIMALS=18
TVD_ACCREDITATION_WORKER_ENABLED=false
TVD_ACCREDITATION_POLL_INTERVAL_MS=5000
TVD_ACCREDITATION_BATCH_SIZE=10
TVD_ACCREDITATION_LOCK_TTL_MS=60000
TVD_OPERATOR_LOCK_TTL_MS=60000
TVD_ACCREDITATION_MAX_ATTEMPTS=5
TVD_ACCREDITATION_RETRY_BASE_MS=5000
TVD_ACCREDITATION_RETRY_MAX_MS=900000
TVD_ACCREDITATION_RECONCILE_AFTER_MS=15000

# No mover variables de flujos internos/ZK a nuevos nombres sin validar
# compatibilidad con emisores externos, CI o despliegues existentes.

# Background processing / tuning
LOCK_TTL_SECONDS=120
MAX_RESOLVES_PER_SLICE=20
SLICE_PAUSE_MS=3000
TOTAL_TABLES_CACHE_MS=120000
TS=8000
LS=30000
LP=true

# AI / document parsing
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
